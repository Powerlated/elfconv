include_guard(GLOBAL)

if(NOT DEFINED ELFCONV_ROOT)
  get_filename_component(ELFCONV_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
set(ELFCONV_LIFTER "${ELFCONV_ROOT}/build/src/lifter/elflift" CACHE FILEPATH "ELF conversion lifter")
set(ELFCONV_EMCC "" CACHE FILEPATH "Emscripten C++ compiler")
set(ELFCONV_EMCC_C "" CACHE FILEPATH "Emscripten C compiler")
if(NOT ELFCONV_EMCC_C)
  if(ELFCONV_EMCC)
    get_filename_component(emscripten_bin_dir "${ELFCONV_EMCC}" DIRECTORY)
    if(EXISTS "${emscripten_bin_dir}/emcc")
      set(ELFCONV_EMCC_C "${emscripten_bin_dir}/emcc" CACHE FILEPATH "Emscripten C compiler" FORCE)
    endif()
  endif()
  if(NOT ELFCONV_EMCC_C)
    find_program(ELFCONV_EMCC_C NAMES emcc)
  endif()
endif()
set(ELFCONV_JOBS 2 CACHE STRING "Concurrent lifting and compiling jobs combined")

function(elfconv_add_conversion_target name)
  set(options INIT_WASM DEBUG FLOAT_STATUS TEXT_IR NO_LIFTED NO_COMPILED READY_JS INCREMENTAL_UNITS JSPI PTHREADS NO_OFFSCREEN_CANVAS)
  set(one_value_args INPUT TARGET OUTPUT_DIR ELF_NAME ENTRY_SYMBOL LIFTER EMCC LEGACY_GL DEBUG_FUNC_ADDR BITCODE_PATH WASI_SDK WASMEDGE NATIVE_CXX LLVM_DIS OUTPUT_EXECUTABLE LINK_MAP OBJECT_BASE WASM_OPT_LEVEL JOBS PTHREAD_POOL_SIZE)
  set(multi_value_args SHARED_LIBRARIES MOUNT_SETTINGS DEPENDS BYPRODUCTS OUTPUTS)
  cmake_parse_arguments(PARSE_ARGV 1 ECV "${options}" "${one_value_args}" "${multi_value_args}")
  if(ECV_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown arguments for ${name}: ${ECV_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT ECV_INPUT OR NOT ECV_TARGET)
    message(FATAL_ERROR "${name} requires INPUT and TARGET")
  endif()
  if(NOT ECV_OUTPUT_DIR)
    set(ECV_OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  endif()
  set(use_lifter_target OFF)
  if(NOT ECV_LIFTER)
    if(TARGET elflift)
      set(ECV_LIFTER "$<TARGET_FILE:elflift>")
      set(use_lifter_target ON)
    else()
      set(ECV_LIFTER "${ELFCONV_LIFTER}")
    endif()
  endif()
  if(NOT ECV_EMCC)
    set(ECV_EMCC "${ELFCONV_EMCC}")
  endif()
  if(NOT DEFINED ECV_JOBS)
    set(ECV_JOBS "${ELFCONV_JOBS}")
  endif()
  set(converter_args)
  foreach(variable IN LISTS one_value_args)
    if(DEFINED ECV_${variable} AND NOT ECV_${variable} STREQUAL "")
      string(TOLOWER "${variable}" option)
      string(REPLACE "_" "-" option "${option}")
      list(APPEND converter_args "--${option}" "${ECV_${variable}}")
    endif()
  endforeach()
  foreach(flag IN LISTS options)
    if(ECV_${flag})
      string(TOLOWER "${flag}" option)
      string(REPLACE "_" "-" option "${option}")
      list(APPEND converter_args "--${option}")
    endif()
  endforeach()
  foreach(library IN LISTS ECV_SHARED_LIBRARIES)
    list(APPEND converter_args --shared-library "${library}")
  endforeach()
  foreach(mount IN LISTS ECV_MOUNT_SETTINGS)
    list(APPEND converter_args --mount "${mount}")
  endforeach()
  set(file_dependencies)
  set(target_dependencies)
  foreach(dependency IN LISTS ECV_DEPENDS)
    if(TARGET "${dependency}")
      list(APPEND target_dependencies "${dependency}")
    else()
      list(APPEND file_dependencies "${dependency}")
    endif()
  endforeach()
  if(ECV_OUTPUTS)
    add_custom_command(OUTPUT ${ECV_OUTPUTS}
      COMMAND "${Python3_EXECUTABLE}" "${ELFCONV_ROOT}/scripts/convert_elf.py" ${converter_args}
      BYPRODUCTS ${ECV_BYPRODUCTS}
      DEPENDS "${ECV_INPUT}" "${ECV_LIFTER}" ${file_dependencies}
      USES_TERMINAL VERBATIM)
    add_custom_target("${name}" DEPENDS ${ECV_OUTPUTS})
  else()
    add_custom_target("${name}"
      COMMAND "${Python3_EXECUTABLE}" "${ELFCONV_ROOT}/scripts/convert_elf.py" ${converter_args}
      BYPRODUCTS ${ECV_BYPRODUCTS}
      DEPENDS ${file_dependencies}
      USES_TERMINAL VERBATIM)
  endif()
  if(target_dependencies)
    add_dependencies("${name}" ${target_dependencies})
  endif()
  if(use_lifter_target)
    add_dependencies("${name}" elflift)
  endif()
endfunction()
