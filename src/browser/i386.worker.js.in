self.onmessage = async function (event) {
  const { canvas, arguments: args, assetRoot, runtimeScript } = event.data;
  try {
    let assets = null;
    if (assetRoot) {
      const root = new URL(assetRoot);
      if (!['http:', 'https:'].includes(root.protocol) || root.username || root.password) {
        throw new Error('assetRoot must be an HTTP(S) URL without credentials');
      }
      if (!root.pathname.endsWith('/')) root.pathname += '/';
      const response = await fetch(new URL('__elfconv_assets.json', root));
      if (!response.ok) throw new Error('Asset manifest request failed: HTTP ' + response.status);
      const manifest = await response.json();
      if (manifest.version !== 1 || !Array.isArray(manifest.files) || !Array.isArray(manifest.directories)) {
        throw new Error('Unsupported game asset manifest');
      }
      assets = { root: root.href, manifest };
    }
    self.Module = {
      canvas,
      arguments: args,
      locateFile: path => new URL(path, runtimeScript).href,
      print: line => self.postMessage({ type: 'output', line: String(line) }),
      printErr: line => self.postMessage({ type: 'output', line: String(line) }),
      onFrame: milliseconds => self.postMessage({ type: 'frame', milliseconds }),
      onRuntimeInitialized: () => self.postMessage({ type: 'running' }),
      onExit: code => self.postMessage({ type: 'exit', code }),
      onAbort: reason => self.postMessage({ type: 'abort', reason: String(reason) })
    };
    importScripts(runtimeScript);
  } catch (error) {
    self.postMessage({ type: 'abort', reason: error instanceof Error ? error.message : String(error) });
  }
};
