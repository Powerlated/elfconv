<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lifted @ELFCONV_NAME@</title>
<style>
  body { background: #202020; color: #eee; font: 16px monospace; margin: 24px; }
  canvas { display: block; max-width: 100%; outline: 1px solid #666; }
  pre { white-space: pre-wrap; }
</style>
<h1>Lifted @ELFCONV_NAME@</h1>
<button id="start">Start</button>
<button id="fullscreen">Fullscreen</button>
<canvas id="canvas" width="640" height="480" tabindex="0"></canvas>
<p id="status">Ready. Start enables browser audio.</p>
<p id="frametime" title="Frame work from input processing through rendering and audio, excluding frame-pacing waits; not a GPU timer">Frame work: — ms</p>
<pre id="output"></pre>
<script>
  function resetFrameTiming() {
    document.getElementById('frametime').textContent = 'Frame work: — ms';
  }
  document.addEventListener('visibilitychange', resetFrameTiming);
  const query = new URLSearchParams(location.search);
  document.getElementById('start').addEventListener('click', function () {
    this.disabled = true;
    if (@ELFCONV_BROWSER_JSPI@ && (typeof WebAssembly.Suspending !== 'function' ||
                                  typeof WebAssembly.promising !== 'function')) {
      document.getElementById('status').textContent =
          'This build requires a browser with WebAssembly JSPI support';
      return;
    }
    const assetRoot = query.get('assetRoot');
    if (!assetRoot) {
      const canvas = document.getElementById('canvas');
      window.Module = {
        canvas,
        arguments: query.getAll('arg'),
        onFrame: function (milliseconds) {
          if (!document.hidden) {
            document.getElementById('frametime').textContent =
                'Frame work: ' + milliseconds.toFixed(2) + ' ms';
          }
        },
        print: line => { document.getElementById('output').textContent += line + '\n'; },
        printErr: line => { document.getElementById('output').textContent += line + '\n'; },
        onRuntimeInitialized: function () {
          document.getElementById('status').textContent = 'Running lifted i386 code';
          canvas.focus();
        },
        onExit: function (code) {
          resetFrameTiming();
          document.getElementById('status').textContent = 'Exited with status ' + code;
          document.body.dataset.exitCode = String(code);
        },
        onAbort: function (reason) {
          resetFrameTiming();
          document.getElementById('status').textContent = 'Aborted: ' + reason;
          document.body.dataset.abort = String(reason);
        }
      };
      document.getElementById('status').textContent = 'Loading Wasm…';
      const script = document.createElement('script');
      script.src = '@ELFCONV_NAME@.js';
      script.onerror = () => { document.getElementById('status').textContent = 'Unable to load runtime'; };
      document.body.appendChild(script);
      return;
    }
    if (typeof OffscreenCanvas === 'undefined') {
      document.getElementById('status').textContent =
          'This build requires OffscreenCanvas for HTTP-backed game files';
      return;
    }
    document.getElementById('status').textContent = 'Starting worker…';
    const worker = new Worker('@ELFCONV_NAME@.worker.js');
    worker.onmessage = function (event) {
      const message = event.data;
      if (message.type === 'output') {
        document.getElementById('output').textContent += message.line + '\n';
      } else if (message.type === 'frame') {
        if (!document.hidden) {
          document.getElementById('frametime').textContent =
              'Frame work: ' + message.milliseconds.toFixed(2) + ' ms';
        }
      } else if (message.type === 'running') {
        document.getElementById('status').textContent = 'Running lifted i386 code';
      } else if (message.type === 'exit') {
        document.getElementById('status').textContent = 'Exited with status ' + message.code;
        document.body.dataset.exitCode = String(message.code);
      } else if (message.type === 'abort') {
        document.getElementById('status').textContent = 'Aborted: ' + message.reason;
        document.body.dataset.abort = String(message.reason);
      }
    };
    worker.onerror = function (event) {
      document.getElementById('status').textContent = 'Worker error: ' + event.message;
    };
    const canvas = document.getElementById('canvas');
    const offscreen = canvas.transferControlToOffscreen();
    worker.postMessage({
      canvas: offscreen,
      arguments: query.getAll('arg'),
      assetRoot,
      runtimeScript: new URL('@ELFCONV_NAME@.js', location.href).href
    }, [offscreen]);
    canvas.focus();
  }, { once: true });
  document.getElementById('fullscreen').addEventListener('click', function () {
    document.getElementById('canvas').requestFullscreen().catch(function (error) {
      document.getElementById('output').textContent += error.message + '\n';
    });
  });
</script>
</html>
